{
  "name": "Hugo",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "GO_VERSION": "1.23.3",
      "HUGO_VERSION": "0.149.0"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "budparr.language-hugo-vscode",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "npm run project-setup && npm install && npm run dev",
  "forwardPorts": [1313]
}
